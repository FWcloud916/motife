  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio src/remotion/index.ts",
    "build": "remotion bundle src/remotion/index.ts",
    "render": "remotion render src/remotion/index.ts JwtAuthFlow out/jwt-auth-flow.mp4",
    "still": "remotion still src/remotion/index.ts JwtAuthFlow out/still.png",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "render:dsl": "node scripts/render-dsl.mjs",
    "motife": "node --env-file-if-exists=.env --import tsx src/agent/cli.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "verify": "pnpm check && pnpm smoke",
    "upgrade:remotion": "remotion upgrade"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
