    "@ai-sdk/xai": "^4.0.38",
    "@dagrejs/dagre": "^3.1.1",
    "@remotion/cli": "4.0.508",
    "@remotion/google-fonts": "4.0.508",
    "@remotion/layout-utils": "4.0.508",
    "@remotion/media": "4.0.508",
    "@remotion/paths": "4.0.508",
    "@remotion/transitions": "4.0.508",
    "ai": "^7.0.64",
    "music-metadata": "^11.14.0",
