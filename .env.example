# Copy to .env (gitignored). Loaded by the `motife` CLI via Node's
# --env-file-if-exists — nothing else in the repo reads these, and
# `pnpm verify` must stay green with no .env present at all.

# LLM providers — set only the ones you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# TTS — OpenAI TTS reuses OPENAI_API_KEY above.
ELEVENLABS_API_KEY=
# ElevenLabs voice ids are account-specific; required when MOTIFE_TTS=elevenlabs
# unless --voice or MOTIFE_TTS_VOICE is set (precedence: --voice >
# MOTIFE_TTS_VOICE > ELEVENLABS_VOICE_ID).
ELEVENLABS_VOICE_ID=

# Optional defaults; CLI flags override these (flag > env > built-in default).
MOTIFE_PROVIDER=anthropic
MOTIFE_MODEL=
# The Phase 4 tts-ab A/B (progress/2026-08-17-phase-4-polish-and-publish/
# tts-ab/LISTEN.md) picked ElevenLabs "Xu Ming" (taiwan mandarin) over
# OpenAI's alloy for zh-TW narration. That verdict is NOT baked into the
# code default (src/tts/defaults.ts stays openai/alloy — a safe,
# zero-config fallback) because an ElevenLabs voice id is account-specific:
# it only works once you've added that voice to YOUR account's library
# (see the harness README for how). Uncomment the three lines below once
# you have — this is a per-environment override, not a project default:
# MOTIFE_TTS=elevenlabs
# MOTIFE_TTS_VOICE=A3T1GnLHdn0WL5w4TMtq
# MOTIFE_TTS_MODEL=eleven_multilingual_v2
MOTIFE_TTS=openai
MOTIFE_TTS_MODEL=
# openai default: alloy. For elevenlabs this outranks ELEVENLABS_VOICE_ID
# above; --voice outranks both.
MOTIFE_TTS_VOICE=
# OpenAI gpt-4o-mini-tts only — accent/style steering, e.g. a one-line
# instruction to read zh-TW technical terms with a Taiwanese pronunciation
# instead of an American accent. Keep it on ONE line (Node's env-file
# parser is not reliably multi-line-safe); for anything longer use
# --tts-instructions instead. This is part of the narration hash, so
# setting/editing it re-synthesizes every cached scene — clear it for one
# run with --tts-instructions "".
MOTIFE_TTS_INSTRUCTIONS=
# Critique (vision) can use a different provider/model than generation —
# it must be vision-capable. Defaults to anthropic.
MOTIFE_CRITIQUE_PROVIDER=
MOTIFE_CRITIQUE_MODEL=
