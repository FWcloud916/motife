# Copy to .env (gitignored). Loaded by the `motife` CLI via Node's
# --env-file-if-exists — nothing else in the repo reads these, and
# `pnpm verify` must stay green with no .env present at all.

# LLM providers — set only the ones you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# TTS — OpenAI TTS reuses OPENAI_API_KEY above.
ELEVENLABS_API_KEY=
# ElevenLabs voice ids are account-specific; required when MOTIFE_TTS=elevenlabs
# unless --voice is passed.
ELEVENLABS_VOICE_ID=

# Optional defaults; CLI flags override these (flag > env > built-in default).
MOTIFE_PROVIDER=anthropic
MOTIFE_MODEL=
MOTIFE_TTS=openai
# Critique (vision) can use a different provider/model than generation —
# it must be vision-capable. Defaults to anthropic.
MOTIFE_CRITIQUE_PROVIDER=
MOTIFE_CRITIQUE_MODEL=
